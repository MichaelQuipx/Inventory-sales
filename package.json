{
  "name": "kj-store",
  "version": "1.0.0",
  "description": "KJ STORE inventory desktop application",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kjstore.app",
    "productName": "KJ STORE",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
